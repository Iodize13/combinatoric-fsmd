[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 100
cover: mode cover
cover: depth 100

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -gW=5 -gN_MAX=7 muldiv_pkg.vhd alu.vhd muldiv_dp.vhd muldiv_ctrl.vhd muldiv.vhd ncr_core.vhd ncr_props.vhd -e ncr_props
prep -top ncr_props

[files]
../rtl/muldiv_pkg.vhd
../rtl/alu.vhd
../rtl/muldiv_dp.vhd
../rtl/muldiv_ctrl.vhd
../rtl/muldiv.vhd
../rtl/ncr_core.vhd
ncr_props.vhd
