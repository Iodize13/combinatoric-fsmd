# prove: unbounded PDR proof at W=4 (PDR cannot close the multiplier at W=8).
# bmc:   bounded check at W=6 over 2 back-to-back operations from reset (W=8 took >400s).
[tasks]
prove
bmc
cover

[options]
prove: mode prove
bmc: mode bmc
bmc: depth 28
cover: mode cover
cover: depth 44

[engines]
prove: abc pdr
bmc: smtbmc yices
cover: smtbmc yices

[script]
plugin -i ghdl
prove: ghdl --std=08 -gW=4 muldiv_pkg.vhd alu.vhd reg_en.vhd sr_flag.vhd down_counter.vhd prodrem_reg.vhd muldiv_status.vhd muldiv_dp.vhd muldiv_next.vhd muldiv_state_reg.vhd muldiv_ctrl.vhd muldiv.vhd muldiv_props.vhd -e muldiv_props
bmc: ghdl --std=08 -gW=6 muldiv_pkg.vhd alu.vhd reg_en.vhd sr_flag.vhd down_counter.vhd prodrem_reg.vhd muldiv_status.vhd muldiv_dp.vhd muldiv_next.vhd muldiv_state_reg.vhd muldiv_ctrl.vhd muldiv.vhd muldiv_props.vhd -e muldiv_props
cover: ghdl --std=08 -gW=8 muldiv_pkg.vhd alu.vhd reg_en.vhd sr_flag.vhd down_counter.vhd prodrem_reg.vhd muldiv_status.vhd muldiv_dp.vhd muldiv_next.vhd muldiv_state_reg.vhd muldiv_ctrl.vhd muldiv.vhd muldiv_props.vhd -e muldiv_props
prep -top muldiv_props

[files]
../rtl/muldiv_pkg.vhd
../rtl/alu.vhd
../rtl/reg_en.vhd
../rtl/sr_flag.vhd
../rtl/down_counter.vhd
../rtl/prodrem_reg.vhd
../rtl/muldiv_status.vhd
../rtl/muldiv_dp.vhd
../rtl/muldiv_next.vhd
../rtl/muldiv_state_reg.vhd
../rtl/muldiv_ctrl.vhd
../rtl/muldiv.vhd
muldiv_props.vhd
